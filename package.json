{
  "name": "codex-git-atlas",
  "version": "1.9.0",
  "private": true,
  "author": "Kurtor",
  "description": "以 Git 为事实底座、以 Codex 为意图上下文的本地代码演化工作台",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "vite --host 0.0.0.0",
    "test:operations": "node scripts/test-branch-operations.mjs",
    "test:git-actions": "node scripts/test-git-actions.mjs",
    "test:codex-evidence": "node scripts/test-codex-evidence.mjs",
    "test:merge-preflight": "node scripts/test-merge-preflight.mjs",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
    "build": "npm run typecheck && vite build && node scripts/build-portable.mjs",
    "pack": "npm run typecheck && vite build && electron-builder --dir"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "dev.kurtor.gitatlas",
    "productName": "Git Atlas",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Git-Atlas-${version}-Windows-${arch}.${ext}"
    }
  }
}
