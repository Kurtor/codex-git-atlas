{
  "name": "codex-git-atlas",
  "version": "1.0.0",
  "private": true,
  "author": "Kurtor",
  "description": "面向 Codex 的本地可视化 Git 历史分析器",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
    "build": "npm run typecheck && vite build && node scripts/build-portable.mjs",
    "pack": "npm run typecheck && vite build && electron-builder --dir"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^38.5.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "dev.kurtor.gitatlas",
    "productName": "Git Atlas",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asar": true,
    "win": { "icon": "build/icon.png", "target": [{ "target": "portable", "arch": ["x64"] }], "artifactName": "Git-Atlas-${version}-Windows-${arch}.${ext}" }
  }
}
